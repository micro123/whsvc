<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>WallhavenService</AssemblyName>
    <RootNamespace>WallhavenService</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\App.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The WinUI build targets copy the app PRI/XBF files to TargetDir, but the
    .NET publish pipeline does not automatically include them when a custom
    publish output directory is used. Without these files the executable
    crashes in Microsoft.UI.Xaml.dll before the first window is shown.
  -->
  <Target Name="IncludeWinUIAssetsInPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_WinUIAssetToPublish Include="$(TargetDir)**\*.xbf" />
      <_WinUIAssetToPublish Include="$(TargetDir)$(AssemblyName).pri"
                            Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />

      <ResolvedFileToPublish Include="@(_WinUIAssetToPublish)">
        <RelativePath>%(_WinUIAssetToPublish.RecursiveDir)%(_WinUIAssetToPublish.Filename)%(_WinUIAssetToPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
