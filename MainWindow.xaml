<Window x:Class="WallhavenService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallhaven 壁纸服务"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Wallhaven 壁纸服务" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="定时抓取并自动更新 Windows 桌面壁纸" Foreground="#666" Margin="0,6,0,0" />
            </StackPanel>
            <Button x:Name="RunButton" Content="立即抓取" Width="110" Height="36" DockPanel.Dock="Right" Click="RunButton_OnClick" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="510" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="抓取设置" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wallhaven API Key" VerticalAlignment="Center" />
                        <PasswordBox x:Name="ApiKeyBox" Grid.Row="0" Grid.Column="1" Margin="8,0,8,8" PasswordChanged="ApiKeyBox_OnPasswordChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="NSFW 内容需要" Foreground="#777" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="搜索关键词列表" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox x:Name="KeywordsBox" Grid.Row="1" Grid.Column="1" Margin="8,0,8,8" Height="82" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="每行一个，每次随机选择" Foreground="#777" VerticalAlignment="Top" Margin="0,5,0,0" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="内容纯度" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,8">
                            <CheckBox x:Name="SfwBox" Content="SFW" Margin="0,0,18,0" />
                            <CheckBox x:Name="SketchyBox" Content="Sketchy" Margin="0,0,18,0" />
                            <CheckBox x:Name="NsfwBox" Content="NSFW" />
                        </StackPanel>
                        <TextBlock x:Name="NsfwHintText" Grid.Row="2" Grid.Column="2" Text="无 API Key 时禁用 NSFW" Foreground="#777" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="壁纸分类" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,8">
                            <CheckBox x:Name="GeneralBox" Content="General" Margin="0,0,18,0" />
                            <CheckBox x:Name="AnimeBox" Content="Anime" Margin="0,0,18,0" />
                            <CheckBox x:Name="PeopleBox" Content="People" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="最低分辨率" VerticalAlignment="Center" />
                        <TextBox x:Name="MinimumResolutionBox" Grid.Row="4" Grid.Column="1" Margin="8,0,8,8" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="例如 1920x1080" Foreground="#777" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="图片比例" VerticalAlignment="Center" />
                        <ComboBox x:Name="AspectRatioBox" Grid.Row="5" Grid.Column="1" Margin="8,0,8,0" SelectedIndex="1">
                            <ComboBoxItem Content="不限" Tag="" />
                            <ComboBoxItem Content="16:9" Tag="16x9" />
                            <ComboBoxItem Content="16:10" Tag="16x10" />
                            <ComboBoxItem Content="21:9" Tag="21x9" />
                            <ComboBoxItem Content="32:9" Tag="32x9" />
                            <ComboBoxItem Content="4:3" Tag="4x3" />
                            <ComboBoxItem Content="5:4" Tag="5x4" />
                            <ComboBoxItem Content="3:2" Tag="3x2" />
                            <ComboBoxItem Content="1:1" Tag="1x1" />
                            <ComboBoxItem Content="9:16" Tag="9x16" />
                            <ComboBoxItem Content="10:16" Tag="10x16" />
                        </ComboBox>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Wallhaven ratios" Foreground="#777" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="定时任务" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ScheduleEnabledBox" Grid.Row="0" Grid.Column="0" Content="启用定时抓取" VerticalAlignment="Center" />
                        <TextBox x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Margin="12,0,8,0" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="分钟" VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="3" Content="保存设置并应用" Width="130" HorizontalAlignment="Right" Click="SaveButton_OnClick" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="下一次搜索关键词" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <TextBox x:Name="NextSearchKeywordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="12,12,0,0" VerticalContentAlignment="Center" />
                    </Grid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="当前壁纸" Padding="14">
                    <StackPanel>
                        <Border Height="230" Background="#ECECEC" BorderBrush="#D5D5D5" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="WallpaperEmptyText" Text="完成一次抓取后显示壁纸信息" Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                                <Image x:Name="CurrentWallpaperImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Tag" Foreground="#666" Margin="0,0,0,7" />
                            <TextBlock x:Name="CurrentTagText" Grid.Row="0" Grid.Column="1" Text="-" TextWrapping="Wrap" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="1" Text="ID" Foreground="#666" Margin="0,0,0,7" />
                            <TextBlock x:Name="CurrentIdText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="2" Text="分辨率" Foreground="#666" Margin="0,0,0,7" />
                            <TextBlock x:Name="CurrentResolutionText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="3" Text="Purity" Foreground="#666" />
                            <TextBlock x:Name="CurrentPurityText" Grid.Row="3" Grid.Column="1" Text="-" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CopyUrlButton" Grid.Column="0" Content="复制页面 URL" Height="34" IsEnabled="False" Click="CopyUrlButton_OnClick" />
                            <Button x:Name="OpenUrlButton" Grid.Column="2" Content="浏览器打开" Height="34" IsEnabled="False" Click="OpenUrlButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="运行状态" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StatusText" FontSize="15" TextWrapping="Wrap" />
                        <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,12,0,0" MinHeight="100" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem Content="程序会常驻系统托盘，关闭窗口不会退出" />
        </StatusBar>
    </Grid>
</Window>
